{
  "name": "@agentlinthq/cli",
  "version": "2.3.0",
  "description": "The Lighthouse for AI coding agents. Audit any repo for how ready it is for Claude Code, Cursor, Codex, Copilot, and Gemini CLI. Get a 0–100 score and a fix list in 30 seconds.",
  "type": "module",
  "bin": {
    "agentlint": "./dist/index.js"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "gemini",
    "agents-md",
    "lint",
    "audit",
    "developer-tools",
    "ci"
  ],
  "homepage": "https://agentlint.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentlint/agentlint.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/agentlint/agentlint/issues"
  },
  "license": "MIT",
  "author": "agentlint contributors",
  "dependencies": {
    "@agentlinthq/core": "workspace:*",
    "fast-glob": "^3.3.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^25.6.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
