{
  "name": "@agentlinthq/core",
  "version": "1.0.0",
  "description": "Pure types and score calculator for agentlint. The Lighthouse for AI coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": ["dist", "README.md"],
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "cursor",
    "copilot",
    "codex",
    "agents-md",
    "lint",
    "audit",
    "developer-tools"
  ],
  "homepage": "https://github.com/agentlint/agentlint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentlint/agentlint.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/agentlint/agentlint/issues"
  },
  "license": "MIT",
  "author": "agentlint contributors",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
