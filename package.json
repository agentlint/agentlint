{
  "name": "agentlint-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "biome check packages",
    "format": "biome format --write packages",
    "typecheck": "pnpm -r --if-present run typecheck",
    "agentlint": "node packages/cli/dist/index.js",
    "ci": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run agentlint .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "lint-staged": {
    "*.{ts,js,json,md}": ["biome check --write --no-errors-on-unmatched"]
  }
}
